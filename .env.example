# Core application secrets
SECRET_KEY=replace-with-a-random-32+_character-secret
JWT_SIGNING_KEY=replace-with-a-random-32+_character-jwt-secret

# Public host/origin policy
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://app.example.com
FRONTEND_URL=https://app.example.com
ENABLE_API_DOCS=false

# Database
DB_NAME=erp_api
DB_USER=erp_api
DB_PASSWORD=replace-me
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_LIFETIME=3600
DB_POOL_MAX_IDLE=600

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Reverse proxy / networking
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=

# Application behavior
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
REPORT_CACHE_TTL=30
IDEMPOTENCY_RETENTION_DAYS=365
AUTH_SESSION_MIN_AGE_HOURS=168
AUTH_SESSION_VERIFICATION_MINUTES=15

# Email (SMTP)
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Object storage (S3-compatible)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_FILE_OVERWRITE=false
AWS_QUERYSTRING_AUTH=true

# Push notifications
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_ANDROID_CHANNEL_ID=erp_notifications
