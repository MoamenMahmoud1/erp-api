# Local full-stack Docker Compose environment.
# Copy this file to .env before running: docker compose up -d --build
# Do not use these placeholder secrets for a public production deployment.

# Core application secrets
SECRET_KEY=dev-only-change-me-to-a-random-32-character-secret
JWT_SIGNING_KEY=dev-only-change-me-to-a-random-32-character-jwt-secret

# Runtime
DJANGO_SETTINGS_MODULE=core.settings.settings_dev
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100

# Public host/origin policy for the local gateway
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_URL=http://localhost:8080
# Frontend build-time API base URL. Keep same-origin by default.
VITE_API_URL=/api/v1
ENABLE_API_DOCS=true

# Database
DB_NAME=erp_api
DB_USER=erp_api
DB_PASSWORD=local-development-only
DB_HOST=127.0.0.1
DB_PORT=5432
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=5
DB_POOL_MAX_LIFETIME=3600
DB_POOL_MAX_IDLE=600

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_TASK_TIME_LIMIT=300
CELERY_TASK_SOFT_TIME_LIMIT=240

# Reverse proxy / networking
# Keep false for the HTTP-only local Compose gateway.
# For real production, terminate TLS at the edge and set these deliberately.
TRUST_PROXY_HEADERS=false
# In Docker Compose, the API resolves the current gateway container IP automatically.
TRUSTED_PROXY_HOSTS=gateway
TRUSTED_PROXY_IPS=

# Application behavior
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=WARNING
REPORT_CACHE_TTL=30
IDEMPOTENCY_RETENTION_DAYS=365
AUTH_SESSION_MIN_AGE_HOURS=168
AUTH_SESSION_VERIFICATION_MINUTES=15

# Email (SMTP) - optional for local development
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Object storage (S3-compatible) - optional until media uploads are enabled
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-central-1
AWS_S3_FILE_OVERWRITE=false
AWS_QUERYSTRING_AUTH=true

# Push notifications
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
GOOGLE_APPLICATION_CREDENTIALS=
FCM_ANDROID_CHANNEL_ID=erp_notifications
